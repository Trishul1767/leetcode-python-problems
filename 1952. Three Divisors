O(N^1/4) solution

class Solution:
    def isThree(self, n: int) -> bool:
        if n == 1: return False # edge case 
        
        x = int(sqrt(n))
        if x*x != n: return False 
        
        for i in range(2, int(sqrt(x))+1): 
            if x % i == 0: return False 
        return True

O(N^.5) solution

class Solution:
    def isThree(self, n: int) -> bool:
        if n == 1: # edge case
            return False

        sqrt = int(n**.5)
        return sqrt*sqrt == n and all(n%a for a in range(2, sqrt))
