class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        f={}
        for i in s:
            if i in f:
                f[i]+=1
            else:
                f[i]=1
        for i in t:
            if i in f:
                f[i]-=1
            else:
                return False
        for j in f.values():
            if j==0:
                x=1
            else:
                x=0
        if x==1:
            return True
        else:
            return False

